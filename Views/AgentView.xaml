<UserControl x:Class="SnowyNotch.Views.AgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="580" Foreground="White">
    <UserControl.Resources>
        <!-- Кольцо агента: остаток лимита + плитка-логотип + имя и процент. -->
        <Style x:Key="RingButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Lift"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LimitTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LimitMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LimitLeft" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,14,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Background="#2EFFFFFF" Margin="0,0,10,0"
                        Click="Back_Click" ToolTip="{l:T 'Назад к сервисам'}">
                    <c:IconGlyph Data="{StaticResource IconChevronLeft}" Width="17" Height="17" StrokeWidth="2.2"/>
                </Button>
                <c:IconGlyph x:Name="HeaderIcon" VerticalAlignment="Center" Data="{StaticResource IconUsage}" Foreground="#B3FFFFFF" Width="19" Height="19"/>
                <TextBlock x:Name="HeaderText" Text="{l:T 'Лимиты'}" FontSize="15" FontWeight="SemiBold" Foreground="#B3FFFFFF" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="SessionsPill" CornerRadius="9" Background="#1FFFFFFF" Padding="8,2" Margin="0,0,6,0" Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SessionsText" FontSize="11.5" Foreground="#B3FFFFFF"/>
                </Border>
                <Border x:Name="FolderPill" CornerRadius="9" Background="#1FFFFFFF" Padding="8,2" Margin="0,0,10,0" Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <c:IconGlyph Data="{StaticResource IconFolder}" Foreground="#B3FFFFFF" Width="13" Height="13"/>
                        <TextBlock x:Name="FolderText" FontSize="11.5" Foreground="#B3FFFFFF" Margin="5,0,0,0" MaxWidth="150"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button x:Name="PageButton" Style="{StaticResource IconButton}" Width="30" Height="30" Background="#2EFFFFFF"
                        Click="PageButton_Click" ToolTip="{l:T 'Прогресс задачи'}">
                    <c:IconGlyph x:Name="PageButtonIcon" Data="{StaticResource IconList}" Width="16" Height="16"/>
                </Button>
                <Button x:Name="ConnectionsButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="8,0,0,0"
                        Background="#2E30D158" Click="Connections_Click" ToolTip="{l:T 'Подключения агентов'}">
                    <c:IconGlyph x:Name="ConnectionsIcon" Data="{StaticResource IconUsage}" Foreground="#30D158" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Страница «Лимиты» ===== -->
        <StackPanel x:Name="UsagePage" Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ClaudeRingButton" Style="{StaticResource RingButton}" Click="ClaudeRing_Click" Width="112">
                    <StackPanel>
                        <Grid Width="80" Height="80">
                            <c:RingProgress x:Name="ClaudeRing" Thickness="5" RingBrush="#E8894F" TrackBrush="#38E8894F"/>
                            <c:AgentLogo x:Name="ClaudeLogo" Agent="Claude" Width="46" Height="46"/>
                        </Grid>
                        <TextBlock Text="Claude" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        <TextBlock x:Name="ClaudeLeftText" FontSize="12.5" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CodexRingButton" Style="{StaticResource RingButton}" Click="CodexRing_Click" Width="112" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid Width="80" Height="80">
                            <c:RingProgress x:Name="CodexRing" Thickness="5" RingBrush="#4A9EFF" TrackBrush="#384A9EFF"/>
                            <c:AgentLogo x:Name="CodexLogo" Agent="Codex" Width="46" Height="46"/>
                        </Grid>
                        <TextBlock Text="Codex" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        <TextBlock x:Name="CodexLeftText" FontSize="12.5" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Карточка выбранного агента со стрелкой к его кольцу -->
            <Grid Margin="0,8,0,0">
                <Path x:Name="CardArrow" Data="M0 9 L9 0 L18 9 Z" Fill="#1E1E20" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Width="18" Height="9">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CardArrowShift"/>
                    </Path.RenderTransform>
                </Path>
                <Border x:Name="DetailCard" Margin="0,8,0,0" CornerRadius="18" Background="#1E1E20" BorderBrush="#1FFFFFFF"
                        BorderThickness="1" Padding="16,13,16,13">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <c:AgentLogo x:Name="DetailLogo" Width="34" Height="34"/>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailName" FontSize="15.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="DetailPlan" FontSize="12.5" Foreground="#99FFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Width="28" Height="28" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="Refresh_Click" ToolTip="{l:T 'Обновить'}" RenderTransformOrigin="0.5,0.5">
                                <c:IconGlyph x:Name="RefreshIcon" Data="{StaticResource IconRefresh}" Foreground="#B3FFFFFF" Width="17" Height="17"
                                             RenderTransformOrigin="0.5,0.5">
                                    <c:IconGlyph.RenderTransform>
                                        <RotateTransform x:Name="RefreshSpin"/>
                                    </c:IconGlyph.RenderTransform>
                                </c:IconGlyph>
                            </Button>
                            <Button x:Name="ConnectButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="{l:T 'Подключить'}" Visibility="Collapsed" Click="Connections_Click"/>
                        </Grid>

                        <StackPanel x:Name="LimitsPanel" Margin="0,12,0,0">
                            <Grid>
                                <TextBlock Text="{l:T 'Текущая сессия'}" Style="{StaticResource LimitTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="FiveResetText" Style="{StaticResource LimitMeta}"/>
                                    <TextBlock x:Name="FiveLeftText" Style="{StaticResource LimitLeft}"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="FiveBar" Height="6" Margin="0,8,0,0">
                                <Border CornerRadius="3" Background="#24FFFFFF"/>
                                <Border x:Name="FiveFill" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{l:T 'Эта неделя'}" Style="{StaticResource LimitTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="WeekResetText" Style="{StaticResource LimitMeta}"/>
                                    <TextBlock x:Name="WeekLeftText" Style="{StaticResource LimitLeft}"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="WeekBar" Height="6" Margin="0,8,0,0">
                                <Border CornerRadius="3" Background="#24FFFFFF"/>
                                <Border x:Name="WeekFill" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Grid>

                            <!-- Дополнительные лимиты (например, недельный на отдельную модель) -->
                            <StackPanel x:Name="ExtraLimits"/>

                            <TextBlock x:Name="BreakdownText" FontSize="12" Foreground="#80FFFFFF" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock x:Name="DetailMessage" FontSize="13" Foreground="#B3FFFFFF" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="Collapsed"/>

                        <Border Height="1" Background="#1AFFFFFF" Margin="0,14,0,12"/>

                        <!-- Что агент делает сейчас — клик открывает прогресс -->
                        <Grid x:Name="NowRow" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NowRow_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Ellipse x:Name="NowCircle" Fill="#2E4A9EFF"/>
                                <c:IconGlyph x:Name="NowIcon" Data="{StaticResource IconList}" Foreground="#4A9EFF" Width="16" Height="16"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NowTitle" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NowSub" FontSize="12.5" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="UpdatedRow" Orientation="Horizontal" Margin="0,12,0,0">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="UpdatedDot" Fill="#30D158"/>
                                <c:IconGlyph x:Name="UpdatedGlyph" Data="{StaticResource IconCheck}" Foreground="Black" Width="11" Height="11" StrokeWidth="2.6"/>
                            </Grid>
                            <TextBlock x:Name="UpdatedText" FontSize="13" FontWeight="SemiBold" Foreground="#30D158" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ===== Страница «Прогресс» ===== -->
        <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
                <Grid Width="40" Height="36" VerticalAlignment="Center">
                    <c:Clawd x:Name="Buddy" Width="40" Height="36"/>
                    <c:AgentLogo x:Name="CodexBuddy" Agent="Codex" Width="34" Height="34" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="AgentNameText" Text="Claude" FontSize="21" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E0784F" Margin="14,2,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" Foreground="#E0784F" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" x:Name="WorkArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Steps" VerticalAlignment="Top"/>

                <Border x:Name="FileCard" Grid.Column="2" CornerRadius="18" Background="#14FFFFFF" Padding="15,13,15,14"
                        VerticalAlignment="Top" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <c:IconGlyph Data="{StaticResource IconNote}" Foreground="#E0784F" Width="18" Height="18"/>
                                <TextBlock x:Name="FileName" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="Bold"
                                           Foreground="#E0784F" Margin="6,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="AddedText" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="Bold" Foreground="#3DDC84"/>
                                <TextBlock x:Name="RemovedText" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF5A4E"
                                           Margin="7,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="FileStatus" FontSize="13" Foreground="#8EFFFFFF" Margin="0,8,0,8"/>
                        <Grid x:Name="Bar" Height="5" ClipToBounds="True">
                            <Border CornerRadius="2.5" Background="#24FFFFFF"/>
                            <Border x:Name="BarFill" CornerRadius="2.5" Background="#E0784F" HorizontalAlignment="Left" Width="0"/>
                            <Border x:Name="BarShimmer" CornerRadius="2.5" HorizontalAlignment="Left" Width="70" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E0784F" Offset="0"/>
                                        <GradientStop Color="#FFE0784F" Offset="0.5"/>
                                        <GradientStop Color="#00E0784F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ShimmerShift"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="TaskText" Grid.Row="2" FontSize="12" Foreground="#73FFFFFF" Margin="0,12,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,4">
                <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="EmptyHint" FontSize="12" Foreground="#8EFFFFFF" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
