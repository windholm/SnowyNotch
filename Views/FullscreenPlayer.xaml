<Window x:Class="SnowyNotch.Views.FullscreenPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SnowyNotch.Localization"
        xmlns:c="clr-namespace:SnowyNotch.Controls"
        Title="SnowyNotch" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Foreground="White" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        WindowStartupLocation="Manual" Left="0" Top="0" Width="800" Height="600">
    <Grid x:Name="Root" ClipToBounds="True" Background="Black">

        <!-- ===== Фон: размытая обложка (два слоя для смены трека), цветные пятна, луч, частицы, затемнения ===== -->
        <Grid x:Name="Backdrop" Opacity="0" IsHitTestVisible="False">
            <!-- Размытие «запечено» в картинку (ImageFx.BlurredFill): BlurEffect на весь экран пересчитывался каждый кадр. -->
            <Border x:Name="BackArtA" Margin="-260" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="DriftScale" ScaleX="1.12" ScaleY="1.12"/>
                        <RotateTransform x:Name="DriftRotate"/>
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border x:Name="BackArtB" Margin="-260" Opacity="0" RenderTransformOrigin="0.5,0.5" Visibility="Hidden"/>

            <Canvas x:Name="Aurora" Opacity="0.55">
                <Ellipse x:Name="BlobA" Width="900" Height="900">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BlobAIn" Color="#B0FF4080" Offset="0"/>
                            <GradientStop x:Name="BlobAOut" Color="#00FF4080" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="BlobAMove"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobB" Width="1100" Height="1100">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BlobBIn" Color="#A04060FF" Offset="0"/>
                            <GradientStop x:Name="BlobBOut" Color="#004060FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="BlobBMove"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobC" Width="760" Height="760">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BlobCIn" Color="#9040E0C0" Offset="0"/>
                            <GradientStop x:Name="BlobCOut" Color="#0040E0C0" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="BlobCMove"/></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Луч проектора (стиль «Кино») -->
            <Rectangle x:Name="Beam" Opacity="0">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,-0.15" GradientOrigin="0.5,-0.15" RadiusX="0.55" RadiusY="0.95">
                        <GradientStop Color="#66FFF3DD" Offset="0"/>
                        <GradientStop Color="#1FFFF3DD" Offset="0.45"/>
                        <GradientStop Color="#00FFF3DD" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Canvas x:Name="Particles" Opacity="0.5"/>

            <Rectangle x:Name="Scrim">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#59000000" Offset="0"/>
                        <GradientStop Color="#33000000" Offset="0.45"/>
                        <GradientStop Color="#B3000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="Vignette">
                <Rectangle.Fill>
                    <RadialGradientBrush RadiusX="0.75" RadiusY="0.8">
                        <GradientStop Color="#00000000" Offset="0.55"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ===== Сцена ===== -->
        <Grid x:Name="Stage" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="StageScale"/></Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColDef" Width="*"/>
                <ColumnDefinition x:Name="RightColDef" Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Текст песни: строки на холсте, затухание сверху и снизу. -->
            <Grid x:Name="LyricsPane" Grid.Column="1" ClipToBounds="True" Opacity="0" Margin="0,0,80,0" Background="Transparent">
                <Grid.RenderTransform><TranslateTransform x:Name="LyricsShift"/></Grid.RenderTransform>
                <Grid.OpacityMask>
                    <!-- Absolute: относительная маска растягивалась на все строки песни (они далеко за краем окна), и пока
                         строки ехали, зона затухания гуляла — видимый текст то и дело становился серым. Высота — из кода. -->
                    <LinearGradientBrush x:Name="LyricsMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,600">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.16"/>
                        <GradientStop Color="#FF000000" Offset="0.82"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Canvas x:Name="LinesCanvas"/>
                <ScrollViewer x:Name="PlainScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Focusable="False" Padding="0,120,0,120">
                    <TextBlock x:Name="PlainText" FontSize="26" FontWeight="SemiBold" Foreground="#D9FFFFFF" TextWrapping="Wrap" LineHeight="40"/>
                </ScrollViewer>
                <TextBlock x:Name="LyricsStatus" FontSize="22" FontWeight="SemiBold" Foreground="#80FFFFFF"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>


            <!-- «Кинетика»: текущая строка по словам, крупно; ниже — следующая, тускло. -->
            <Grid x:Name="KineticHost" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="False"/>
            <!-- «Парящий»: строки возникают в разных местах экрана. -->
            <c:FloatingLyrics x:Name="FloatHost" Grid.ColumnSpan="2" Visibility="Collapsed" SafeArea="0.06,0.12,0.06,0.3"/>
            <StackPanel x:Name="LeftCol" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>

                <!-- Обложка: свечение в цвет трека (пульсирует в такт), уменьшение на паузе. Квадрат или пластинка. -->
                <Grid x:Name="CoverHost" Width="420" Height="420" RenderTransformOrigin="0.5,0.5" Opacity="0" HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FlyScale"/>
                            <TranslateTransform x:Name="FlyShift"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="CoverGlow" Margin="-90" IsHitTestVisible="False" Opacity="0.85" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="GlowScale"/></Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="CoverGlowIn" Color="#807FD8FF" Offset="0.35"/>
                                <GradientStop x:Name="CoverGlowOut" Color="#007FD8FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="PauseScale"/></Grid.RenderTransform>

                        <Grid x:Name="SquareArt">
                            <!-- Тень — готовая картинка (как DropShadowEffect: размытие 70, сдвиг 22 вниз, 60 %), см. UpdateShadows. -->
                            <Border x:Name="CoverShadow" IsHitTestVisible="False"/>
                            <Border x:Name="Cover" CornerRadius="28" Background="#2A2A2E"/>
                            <Border x:Name="CoverNext" CornerRadius="28" Opacity="0"/>
                            <Border x:Name="CoverShine" CornerRadius="28" IsHitTestVisible="False" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                                        <GradientStop Color="#55FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                                        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShineMove" X="-1"/></LinearGradientBrush.RelativeTransform>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="28" BorderThickness="1" BorderBrush="#26FFFFFF" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Пластинка: диск с бороздками крутится, обложка — этикетка; блик стоит на месте; тонарм. -->
                        <Grid x:Name="VinylArt" Visibility="Collapsed">
                            <!-- Тень пластинки — готовая картинка (размытие 60, сдвиг 20 вниз, 65 %). -->
                            <Border x:Name="VinylShadow" IsHitTestVisible="False"/>
                            <Ellipse Fill="Black"/>
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="DiscSpin"/></Grid.RenderTransform>
                                <Ellipse x:Name="Disc"/>
                                <Ellipse x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="LabelRing" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#40000000" StrokeThickness="2"/>
                            </Grid>
                            <Ellipse x:Name="Spindle" Width="12" Height="12" Fill="#D0D0D4" Stroke="#60000000" StrokeThickness="1"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                                        <GradientStop Color="#2CFFFFFF" Offset="0.38"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#1EFFFFFF" Offset="0.64"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Canvas x:Name="Tonearm" IsHitTestVisible="False">
                                <Canvas.RenderTransform><RotateTransform x:Name="ArmAngle" Angle="-24"/></Canvas.RenderTransform>
                                <Path x:Name="ArmPath" Stroke="#E6D9D9DE" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="6" Opacity="0.6" RenderingBias="Performance"/></Path.Effect>
                                </Path>
                                <Ellipse x:Name="ArmPivot" Width="38" Height="38" Fill="#2A2A2E" Stroke="#9A9AA0" StrokeThickness="3"/>
                                <Rectangle x:Name="ArmHead" Width="26" Height="16" RadiusX="3" RadiusY="3" Fill="#CFCFD4"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="TitleRow" Margin="0,40,0,0" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <StackPanel x:Name="TitleStack" Margin="0,0,44,0">
                        <TextBlock x:Name="TitleText" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" FontSize="20" Foreground="#B3FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <c:AudioBars x:Name="Bars" Width="28" Height="22" BarCount="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="ProgressRow" Margin="0,26,0,0" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Track" Height="26" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Track_MouseLeftButtonDown">
                        <c:WaveProgress x:Name="Wave" Thickness="6" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <TextBlock x:Name="ElapsedText" FontSize="13.5" Foreground="#99FFFFFF"/>
                        <TextBlock x:Name="RemainingText" FontSize="13.5" Foreground="#99FFFFFF" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0">
                    <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                    <Button Style="{StaticResource IconButton}" Width="72" Height="64" VerticalAlignment="Center" Click="Prev_Click">
                        <c:IconGlyph Data="{StaticResource GlyphPrev}" Filled="True" Width="40" Height="40"/>
                    </Button>
                    <!-- Треугольник «play» в самой геометрии уже смещён для оптического центра — без отступов. -->
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="84" Height="84" Margin="30,0" VerticalAlignment="Center"
                            Click="PlayPause_Click">
                        <Grid Width="84" Height="84">
                            <Ellipse Fill="White"/>
                            <c:IconGlyph x:Name="PlayGlyph" Data="{StaticResource GlyphPlay}" Filled="True" Width="40" Height="40"
                                         Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <c:IconGlyph x:Name="PauseGlyph" Data="{StaticResource GlyphPause}" Filled="True" Width="40" Height="40"
                                         Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="72" Height="64" VerticalAlignment="Center" Click="Next_Click">
                        <c:IconGlyph Data="{StaticResource GlyphNext}" Filled="True" Width="40" Height="40"/>
                    </Button>
                </StackPanel>

                <!-- Субтитр (стиль «В центре»): текущая строка песни под управлением. -->
                <Grid x:Name="Caption" Margin="0,30,0,0" Visibility="Collapsed" ClipToBounds="False">
                    <TextBlock x:Name="CaptionA" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Opacity="0">
                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CaptionB" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Opacity="0">
                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ===== Плёнка: зерно и кашетирование (стиль «Кино») ===== -->
        <Rectangle x:Name="Grain" Opacity="0" IsHitTestVisible="False"/>
        <Rectangle x:Name="BarTop" Fill="Black" Height="0" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Rectangle x:Name="BarBottom" Fill="Black" Height="0" VerticalAlignment="Bottom" IsHitTestVisible="False"/>

        <!-- ===== Верх: выход слева, стиль справа. Прячутся вместе с курсором, когда мышь не двигается. ===== -->
        <StackPanel x:Name="TopBar" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,32,0,0" Opacity="0">
            <Button Style="{StaticResource IconButton}" Width="48" Height="48" Background="#2EFFFFFF" Click="Close_Click"
                    ToolTip="{l:T 'Выйти (Esc)'}">
                <c:IconGlyph Data="{StaticResource IconChevronLeft}" Width="22" Height="22" StrokeWidth="2.3" RenderTransformOrigin="0.5,0.5">
                    <c:IconGlyph.RenderTransform><RotateTransform Angle="-90"/></c:IconGlyph.RenderTransform>
                </c:IconGlyph>
            </Button>
        </StackPanel>
        <StackPanel x:Name="TopRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,36,0" Opacity="0">
            <Border x:Name="StyleToast" Background="#33FFFFFF" CornerRadius="16" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0">
                <TextBlock x:Name="StyleToastText" FontSize="14" FontWeight="SemiBold"/>
            </Border>
            <!-- «Текст поверх экрана»: включает (плеер закрывается) и выключает (плеер остаётся). Включён — кнопка светлая. -->
            <Button x:Name="OverlayButton" Style="{StaticResource IconButton}" Width="48" Height="48" Background="#2EFFFFFF" Margin="0,0,10,0"
                    Click="Overlay_Click" ToolTip="{l:T 'Текст поверх экрана'}">
                <c:IconGlyph x:Name="OverlayGlyph" Data="{StaticResource IconFloatText}" Width="21" Height="21" StrokeWidth="1.8"/>
            </Button>
            <!-- Стиль: круглая кнопка со слоями, без подписи — названия только в раскрывающемся меню. -->
            <Button x:Name="StyleButton" Style="{StaticResource IconButton}" Width="48" Height="48" Background="#2EFFFFFF" Click="Style_Click"
                    ToolTip="{l:T 'Сменить стиль (S)'}">
                <c:IconGlyph Data="{StaticResource IconLayers}" Width="21" Height="21" StrokeWidth="1.8"/>
            </Button>
        </StackPanel>
        <Popup x:Name="StyleMenu" PlacementTarget="{Binding ElementName=StyleButton}" Placement="Bottom" VerticalOffset="10"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="#F21C1C20" CornerRadius="18" Padding="8" BorderBrush="#26FFFFFF" BorderThickness="1" MinWidth="240">
                <StackPanel>
                    <StackPanel x:Name="StyleList"/>
                    <!-- Текста нет (или он без синхронизации): эффекты стилей строятся на строках песни — предупреждаем здесь,
                         где стиль и выбирают, а не поверх всего экрана. -->
                    <Border x:Name="NoLyricsNote" Visibility="Collapsed" Margin="0,6,0,0" Padding="14,10,14,8"
                            BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse Stroke="#99FFFFFF" StrokeThickness="1.4"/>
                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#99FFFFFF" FontFamily="Georgia"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="NoLyricsText" Grid.Column="1" FontSize="13" Foreground="#A6FFFFFF" Margin="9,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="215" LineHeight="18"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
