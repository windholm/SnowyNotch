<UserControl x:Class="SnowyNotch.Widgets.MediaHero"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Foreground="White">
    <Grid Margin="22,18,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Width="176" Height="176">
            <Ellipse x:Name="Glow" Width="230" Height="230" Margin="-27" Opacity="0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowInner" Color="#660A84FF" Offset="0"/>
                        <GradientStop x:Name="GlowOuter" Color="#000A84FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Border x:Name="BigArt" CornerRadius="20" Background="#2A2A2E" Cursor="Hand" ToolTip="{l:T 'Свернуть обложку'}"
                    RenderTransformOrigin="0.15,0.2">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BigArtScale"/>
                </Border.RenderTransform>
            </Border>
        </Grid>

        <StackPanel x:Name="Details" Grid.Column="2" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="DetailsShift"/>
            </StackPanel.RenderTransform>
            <Grid Margin="0,0,0,10">
                <c:AudioBars x:Name="Bars" Width="22" Height="16" BarCount="6" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Width="30" Height="28" Background="#1FFFFFFF"
                            Margin="0,0,8,0" Click="Fullscreen_Click" ToolTip="{l:T 'Во весь экран'}">
                        <c:IconGlyph Data="{StaticResource IconExpand}" Width="15" Height="15" StrokeWidth="1.8"/>
                    </Button>
                <Button x:Name="LyricsButton" Style="{StaticResource PillButton}" Padding="9,4"
                        Click="Lyrics_Click" ToolTip="{l:T 'Текст песни'}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconGlyph Data="{StaticResource IconLyrics}" Width="15" Height="15"/>
                        <TextBlock Text="{l:T 'Текст'}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56"
                       TextTrimming="CharacterEllipsis" LineHeight="27"/>
            <TextBlock x:Name="ArtistText" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <Grid Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid x:Name="Track" Height="22" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Track_MouseLeftButtonDown">
                    <c:WaveProgress x:Name="Wave" Thickness="5" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="ElapsedText" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="RemainingText" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource IconButton}" Width="50" Height="42" Click="Prev_Click">
                    <c:IconGlyph Data="{StaticResource GlyphPrev}" Filled="True" Width="30" Height="30"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="56" Height="48" Margin="18,0" Click="PlayPause_Click">
                    <Grid>
                        <c:IconGlyph x:Name="PlayGlyph" Data="{StaticResource GlyphPlay}" Filled="True" Width="36" Height="36"/>
                        <c:IconGlyph x:Name="PauseGlyph" Data="{StaticResource GlyphPause}" Filled="True" Width="36" Height="36"
                                     Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="50" Height="42" Click="Next_Click">
                    <c:IconGlyph Data="{StaticResource GlyphNext}" Filled="True" Width="30" Height="30"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
