<UserControl x:Class="SnowyNotch.Widgets.SystemWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="220" Foreground="White">
    <Grid Height="114">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <UniformGrid Columns="2" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <Grid Width="38" Height="38">
                    <c:RingProgress x:Name="CpuRing" Thickness="3.5" RingBrush="#5E5CE6"/>
                    <c:IconGlyph Data="{StaticResource IconCpu}" Foreground="#A9A8FF" Width="19" Height="19" StrokeWidth="1.4"/>
                </Grid>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="#A9A8FF"/>
                    <TextBlock x:Name="CpuText" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="38" Height="38">
                    <c:RingProgress x:Name="RamRing" Thickness="3.5" RingBrush="#30D158"/>
                    <c:IconGlyph Data="{StaticResource IconMemory}" Foreground="#7BE495" Width="19" Height="19" StrokeWidth="1.4"/>
                </Grid>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="#7BE495"/>
                    <TextBlock x:Name="RamText" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </UniformGrid>
        <Grid Grid.Row="1" Margin="0,10,0,4" x:Name="GraphHost">
            <Polygon x:Name="CpuArea" Stretch="None">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#665E5CE6" Offset="0"/>
                        <GradientStop Color="#005E5CE6" Offset="1"/>
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>
            <Polyline x:Name="CpuLine" Stroke="#8F8DFF" StrokeThickness="1.5" StrokeLineJoin="Round"/>
        </Grid>
    </Grid>
</UserControl>
