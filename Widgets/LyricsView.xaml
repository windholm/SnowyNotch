<UserControl x:Class="SnowyNotch.Widgets.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="560" Foreground="White">
    <Grid Margin="14,10,22,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Foreground="#B3FFFFFF"
                        Click="Back_Click" ToolTip="{l:T 'Назад'}">
                    <c:IconGlyph Data="{StaticResource IconChevronLeft}" Width="20" Height="20" StrokeWidth="2"/>
                </Button>
                <Border x:Name="Art" Width="30" Height="30" CornerRadius="7" Margin="6,0,0,0" Background="#2A2A2E"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="380">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True" x:Name="Viewport" Margin="16,0,0,0">
            <!-- Absolute и высота области (220): относительная маска растягивалась на ВСЕ строки песни,
                 и в начале трека весь видимый текст попадал в зону затухания — строки были серыми. -->
            <Grid.OpacityMask>
                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,220">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.16"/>
                    <GradientStop Color="Black" Offset="0.78"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Canvas x:Name="LinesCanvas"/>
            <ScrollViewer x:Name="PlainScroll" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <TextBlock x:Name="PlainText" FontSize="17" FontWeight="SemiBold" LineHeight="26" TextWrapping="Wrap"
                           Foreground="#D9FFFFFF" Margin="0,30,10,30"/>
            </ScrollViewer>
            <StackPanel x:Name="Status" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
