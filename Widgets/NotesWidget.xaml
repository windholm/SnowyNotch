<UserControl x:Class="SnowyNotch.Widgets.NotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="420" Foreground="White">
    <UserControl.Resources>
        <!-- Кнопка панели форматирования: текст или иконка в маленькой круглой «таблетке». -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="ToolText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- ===== Список заметок ===== -->
        <Grid x:Name="ListPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="2,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Заметки'}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="CountText" FontSize="16" FontWeight="SemiBold" Foreground="#66FFFFFF" Margin="7,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Background="#2EFFFFFF" HorizontalAlignment="Right"
                        Click="New_Click" ToolTip="{l:T 'Новая заметка'}">
                    <c:IconGlyph Data="{StaticResource IconNewNote}" Width="17" Height="17"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" x:Name="ListScroll" MaxHeight="252" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Rows"/>
            </ScrollViewer>
            <StackPanel Grid.Row="1" x:Name="EmptyList" Margin="0,18,0,18" Visibility="Collapsed">
                <c:AppIcon Width="46" Height="46" Glyph="{StaticResource AppGlyphNotes}" Top="#3C3C41" Bottom="#1A1A1D"
                           GlyphTop="#FFE57A" GlyphBottom="#FFB300" HorizontalAlignment="Center"/>
                <TextBlock Text="{l:T 'Пока нет заметок'}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="{l:T 'Markdown, списки, чек-листы — копируется чистым текстом'}" FontSize="12" Foreground="#8EFFFFFF"
                           HorizontalAlignment="Center" Margin="0,2,0,10"/>
                <Button Style="{StaticResource PillButton}" Background="#FFD60A" HorizontalAlignment="Center" Click="New_Click">
                    <TextBlock Text="{l:T 'Создать заметку'}" Foreground="Black" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Редактор ===== -->
        <Grid x:Name="EditorPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Background="#2EFFFFFF" HorizontalAlignment="Left"
                        Click="Back_Click" ToolTip="{l:T 'Все заметки'}">
                    <c:IconGlyph Data="{StaticResource IconChevronLeft}" Width="18" Height="18" StrokeWidth="2.2"/>
                </Button>
                <TextBlock x:Name="SavedText" FontSize="11.5" Foreground="#73FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Width="32" Height="32" Background="#2EFFFFFF"
                            Click="CopyNote_Click" ToolTip="{l:T 'Скопировать как Markdown'}">
                        <c:IconGlyph x:Name="CopyIcon" Data="{StaticResource IconCopy}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Background="#2EFFFFFF" Margin="8,0,0,0"
                            Click="DeleteNote_Click" ToolTip="{l:T 'Удалить заметку'}">
                        <c:IconGlyph Data="{StaticResource IconTrash}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="2,10,0,10" Height="196">
                <TextBlock x:Name="Placeholder" Text="{l:T 'Новая заметка'}" FontSize="22" FontWeight="Bold" Foreground="#40FFFFFF"
                           IsHitTestVisible="False" Margin="2,4,0,0"/>
                <c:MarkdownEditor x:Name="Editor" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"/>
            </Grid>

            <!-- Панель форматирования -->
            <Border Grid.Row="2" CornerRadius="16" Background="#1FFFFFFF" Padding="4,3" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="Bold_Click" ToolTip="{l:T 'Жирный (Ctrl+B)'}">
                        <TextBlock Text="B" Style="{StaticResource ToolText}" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Italic_Click" ToolTip="{l:T 'Курсив (Ctrl+I)'}">
                        <TextBlock Text="I" Style="{StaticResource ToolText}" FontStyle="Italic" FontFamily="Georgia"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Underline_Click" ToolTip="{l:T 'Подчеркнуть (Ctrl+U)'}">
                        <TextBlock Text="U" Style="{StaticResource ToolText}" TextDecorations="Underline"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Strike_Click" ToolTip="{l:T 'Зачеркнуть (Ctrl+Shift+X)'}">
                        <TextBlock Text="S" Style="{StaticResource ToolText}" TextDecorations="Strikethrough"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Highlight_Click" ToolTip="{l:T 'Маркер (Ctrl+Shift+H)'}">
                        <c:IconGlyph Data="{StaticResource IconMarker}" Foreground="#FFD60A" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="ColorButton" Style="{StaticResource ToolButton}" Click="Color_Click" ToolTip="{l:T 'Цвет текста'}">
                        <Ellipse x:Name="ColorDot" Width="13" Height="13" Fill="#FFD60A"/>
                    </Button>
                    <Border Style="{StaticResource ToolDivider}"/>
                    <Button Style="{StaticResource ToolButton}" Click="H1_Click" ToolTip="{l:T 'Заголовок 1 (Ctrl+1)'}">
                        <TextBlock Text="H1" Style="{StaticResource ToolText}" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="H2_Click" ToolTip="{l:T 'Заголовок 2 (Ctrl+2)'}">
                        <TextBlock Text="H2" Style="{StaticResource ToolText}" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="H3_Click" ToolTip="{l:T 'Заголовок 3 (Ctrl+3)'}">
                        <TextBlock Text="H3" Style="{StaticResource ToolText}" FontSize="12"/>
                    </Button>
                    <Border Style="{StaticResource ToolDivider}"/>
                    <Button Style="{StaticResource ToolButton}" Click="Bullet_Click" ToolTip="{l:T 'Список'}">
                        <c:IconGlyph Data="{StaticResource IconList}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Number_Click" ToolTip="{l:T 'Нумерованный список'}">
                        <c:IconGlyph Data="{StaticResource IconListNumber}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Todo_Click" ToolTip="{l:T 'Чек-лист (Ctrl+Shift+L)'}">
                        <c:IconGlyph Data="{StaticResource IconTodo}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Quote_Click" ToolTip="{l:T 'Цитата'}">
                        <c:IconGlyph Data="{StaticResource IconQuote}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>

            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Top" VerticalOffset="-6"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border CornerRadius="14" Background="#F2242426" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="6">
                    <StackPanel x:Name="Swatches" Orientation="Horizontal"/>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
