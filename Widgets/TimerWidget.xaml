<UserControl x:Class="SnowyNotch.Widgets.TimerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="250" Foreground="White">
    <Grid Height="114">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Режим: обычный таймер на любое время или классический помидоро -->
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SimpleChip" Style="{StaticResource ChipToggle}" Content="{l:T 'Таймер'}" GroupName="TimerMode"
                         Checked="Mode_Checked" Margin="0,0,6,0"/>
            <RadioButton x:Name="PomodoroChip" Style="{StaticResource ChipToggle}" Content="{l:T 'Помидоро'}" GroupName="TimerMode"
                         Checked="Mode_Checked"/>
        </StackPanel>

        <!-- Обычный таймер: линейка минут (до 3 часов) -->
        <c:MinuteRuler x:Name="Ruler" Grid.Row="1" VerticalAlignment="Center" Maximum="180" Committed="Ruler_Committed"/>

        <!-- Помидоро: этап и прогресс цикла из четырёх -->
        <Grid x:Name="PomodoroPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PhaseText" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="PhaseHint" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="{l:T 'Помидоры в цикле: после четвёртого — длинный перерыв'}"/>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Style="{StaticResource PillButton}" Background="#40FF9F0A" Padding="14,7"
                        Click="Start_Click">
                    <TextBlock x:Name="StartText" Text="{l:T 'Старт'}" Foreground="{StaticResource TimerOrange}" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0" Background="#1FFFFFFF"
                        Click="Reset_Click" ToolTip="{l:T 'Сбросить'}">
                    <c:IconGlyph Data="{StaticResource IconReset}" Width="16" Height="16"/>
                </Button>
                <Button x:Name="SkipButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0" Background="#1FFFFFFF"
                        Click="Skip_Click" ToolTip="{l:T 'Следующий этап'}" Visibility="Collapsed">
                    <c:IconGlyph Data="{StaticResource IconSkip}" Width="15" Height="15"/>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TimerOrange}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
