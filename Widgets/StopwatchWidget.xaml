<UserControl x:Class="SnowyNotch.Widgets.StopwatchWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="200" Foreground="White">
    <Grid Height="116">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Width="72" Height="72" VerticalAlignment="Center">
            <c:RingProgress Thickness="4.5" RingBrush="{StaticResource StopwatchCyan}" Progress="{Binding Progress}"/>
            <c:IconGlyph Data="{StaticResource IconStopwatch}" Foreground="{StaticResource StopwatchCyan}"
                         Width="28" Height="28" StrokeWidth="1.7"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{l:T 'Секундомер'}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text="{Binding Display}" FontSize="22" FontWeight="SemiBold" Margin="0,1,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Background="#3364D2FF"
                        Foreground="{StaticResource StopwatchCyan}" Click="Toggle_Click">
                    <Grid>
                        <c:IconGlyph Data="{StaticResource GlyphPlay}" Filled="True" Width="18" Height="18"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        <c:IconGlyph Data="{StaticResource GlyphPause}" Filled="True" Width="18" Height="18"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Background="#1FFFFFFF" Margin="6,0,0,0"
                        Click="Reset_Click" ToolTip="{l:T 'Сбросить'}">
                    <c:IconGlyph Data="{StaticResource IconReset}" Width="17" Height="17"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
