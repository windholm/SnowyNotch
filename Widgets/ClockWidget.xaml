<UserControl x:Class="SnowyNotch.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Foreground="White">
    <Grid>
        <!-- Часы: всё по центру своей колонки. В режиме сервиса клик открывает календарь. -->
        <Border x:Name="ClockPage" Width="150" Height="114" CornerRadius="16" Background="Transparent"
                MouseEnter="ClockPage_MouseEnter" MouseLeave="ClockPage_MouseLeave"
                MouseLeftButtonUp="ClockPage_MouseLeftButtonUp">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="DayText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                    <TextBlock x:Name="DayNumText" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                    <TextBlock x:Name="WeekText" FontSize="12" FontWeight="SemiBold" Foreground="#B3FF453A" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TimeText" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Календарь на месяц -->
        <StackPanel x:Name="CalendarPage" Width="238" Visibility="Collapsed" Background="Transparent"
                    MouseWheel="CalendarPage_MouseWheel">
            <Grid Margin="2,0,0,6">
                <TextBlock x:Name="MonthText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="MonthText_MouseLeftButtonUp"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Background="#1FFFFFFF" Click="PrevMonth_Click">
                        <c:IconGlyph Data="{StaticResource IconChevronLeft}" Width="15" Height="15" StrokeWidth="2.2"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Background="#1FFFFFFF" Margin="6,0,0,0" Click="NextMonth_Click">
                        <c:IconGlyph Data="{StaticResource IconChevronLeft}" Width="15" Height="15" StrokeWidth="2.2" RenderTransformOrigin="0.5,0.5">
                            <c:IconGlyph.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </c:IconGlyph.RenderTransform>
                        </c:IconGlyph>
                    </Button>
                </StackPanel>
            </Grid>
            <UniformGrid x:Name="WeekdayRow" Columns="7" Rows="1" Margin="0,0,0,2"/>
            <UniformGrid x:Name="DaysGrid" Columns="7"/>
        </StackPanel>
    </Grid>
</UserControl>
