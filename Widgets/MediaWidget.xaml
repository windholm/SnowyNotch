<UserControl x:Class="SnowyNotch.Widgets.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SnowyNotch.Localization"
             xmlns:c="clr-namespace:SnowyNotch.Controls"
             Width="300" Foreground="White">
    <Grid>
        <Grid x:Name="Player" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="Art" Width="48" Height="48" CornerRadius="11" HorizontalAlignment="Left" Background="#2A2A2E"
                    Cursor="Hand" ToolTip="{l:T 'Открыть обложку'}" RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonUp="Art_MouseLeftButtonUp" MouseEnter="Art_MouseEnter" MouseLeave="Art_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ArtScale"/>
                </Border.RenderTransform>
            </Border>
            <StackPanel Margin="60,0,62,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Background="Transparent"
                           MouseLeftButtonUp="Source_MouseLeftButtonUp"/>
            </StackPanel>
            <Button x:Name="LyricsButton" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,28,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#99FFFFFF"
                    Click="Lyrics_Click" ToolTip="{l:T 'Текст песни'}">
                <c:IconGlyph Data="{StaticResource IconLyrics}" Width="17" Height="17"/>
            </Button>
            <c:AudioBars x:Name="Bars" Width="20" Height="15" BarCount="6"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <Grid x:Name="Track" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Track_MouseLeftButtonDown">
                    <Border Height="4" CornerRadius="2" Background="#29FFFFFF" VerticalAlignment="Center"/>
                    <Border x:Name="Fill" Height="4" CornerRadius="2" Width="0" Background="#E6FFFFFF"
                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Width="34" Height="34"
                        HorizontalAlignment="Left" Click="Shuffle_Click" ToolTip="{l:T 'Перемешать'}">
                    <c:IconGlyph Data="{StaticResource IconShuffle}" Width="17" Height="17"/>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="44" Height="38" Click="Prev_Click">
                        <c:IconGlyph Data="{StaticResource GlyphPrev}" Filled="True" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="46" Height="40" Margin="12,0" Click="PlayPause_Click">
                        <Grid>
                            <c:IconGlyph x:Name="PlayGlyph" Data="{StaticResource GlyphPlay}" Filled="True" Width="28" Height="28"/>
                            <c:IconGlyph x:Name="PauseGlyph" Data="{StaticResource GlyphPause}" Filled="True" Width="28" Height="28"
                                         Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="44" Height="38" Click="Next_Click">
                        <c:IconGlyph Data="{StaticResource GlyphNext}" Filled="True" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Width="34" Height="34"
                        HorizontalAlignment="Right" Click="Repeat_Click" ToolTip="{l:T 'Повтор'}">
                    <Grid>
                        <c:IconGlyph Data="{StaticResource IconRepeat}" Width="17" Height="17"/>
                        <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="7.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="Empty" Height="116">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="#1AFFFFFF" HorizontalAlignment="Center">
                    <c:IconGlyph Data="{StaticResource IconMusic}" Foreground="#8CFFFFFF" Width="22" Height="22"/>
                </Border>
                <TextBlock Text="{l:T 'Ничего не играет'}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                <TextBlock Text="{l:T 'Включите Spotify, SoundCloud или другую музыку'}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
